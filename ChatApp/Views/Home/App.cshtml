@{
    Layout = null;
    ViewData["Title"] = "Chat";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ChatApp</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ACE_MVC.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/styles.css" />

    <script defer src="~/js/signalr/signalr.min.js"></script>

</head>
<body style="background: linear-gradient(135deg, #e1ffd2, #fffed6); max-height: 100vh;">
    <div class="app-container">
        <main class="container-fluid">
            <input type="hidden" id="loggedInUser" value="@ViewBag.Username" />

            <div class="container-fluid h-100">
                <div class="row h-100">


                    <!-- Contacts Section -->
                    <div class="col-md-3 bg-white p-3 border-end d-flex flex-column">
                        <!-- Header -->
                        <div class="d-flex justify-content-between align-items-center">
                            <h5>Contacts</h5>
                            <h5 class="client">@(ViewBag.Username?.Substring(0, 1).ToUpper() + ViewBag.Username?.Substring(1))</h5>
                        </div>

                        <!-- Search Bar & Logged-in User -->
                        <div class="d-flex justify-content-between align-items-center userinfo">
                            <input type="text" class="form-control" id="searchbar" placeholder="Search Contacts">
                        </div>

                        <!-- Contact List -->
                        <div id="contactList" class="list-group flex-grow-1"></div>

                        <!-- Footer -->
                        <div class="contacts-footer mt-auto text-center">
                            <button  class="btn-danger" onclick="location.href='@Url.Action("Login", "Account")'">Logout</button>
                            <button id="add-contact-btn">Add Contact</button>
                        </div>
                    </div>

            <!-- Chat Section -->
            <div class="col-md-9 d-flex flex-column h-100">
                <!-- Messages Section -->
                <div class="flex-grow-1 overflow-auto" id="messages-section"></div>

                <!-- Input Section -->
                <div class="input-div">
                    <div class="input-group">
                        <input type="text" id="message-input" class="form-control" placeholder="Type a message">
                        <button id="send-button">Send</button>
                    </div>
                </div>
            </div>



                </div>
            </div>
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        let selectedContact = null;
        let contactMessages = {};

        document.addEventListener("DOMContentLoaded", async function () {
            const loggedInUser = document.getElementById("loggedInUser").value;
            
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/chatHub?username=" + loggedInUser)
                .configureLogging(signalR.LogLevel.Information)
                .build();


            console.log("Logged in user:", loggedInUser);
            fetchContacts (loggedInUser);

            document.getElementById("add-contact-btn").addEventListener("click", function () {
                let contactname = prompt("Enter the contact to add as a contact:");

                if (contactname) {

                    fetch(`/api/chat/addUser?addedContact=${contactname}&userName=${loggedInUser}`)
                        .then(response => {
                            if (response.ok) {
                                return response.json();
                            } else {
                                return response.json().then(error => {
                                    throw new Error(error.message || "User not found");
                                });
                            }
                        })
                        .then(data => {
                            if (data.success) {
                                createContactElement(contactname);
                                alert(data.message);
                            } else {
                                alert(data.message);
                            }
                        })
                        .catch(err => {
                            console.error(err);
                            alert(err.message);
                        });
                }
            });

            async function fetchContacts (clientname) {
                try {
                    const contactList = document.getElementById("contactList");
                    contactList.innerHTML = 'Loading contacts...';

                    const response = await fetch(`/api/chat/getContacts?clientname=${clientname}`);

                    if (!response.ok) {
                        throw new Error('No contacts found!');
                    }

                    const data = await response.json();
                    console.log("API Response:", data);

                    contactList.innerHTML = '';

                    populateContacts (data);

                } catch (error) {
                    console.error('Error:', error.message);
                }
            }


                async function fetchMessages (clientname, selectedContact) {
                try {
                    const response = await fetch(`/api/chat/getMessages?clientname=${clientname}&contactname=${selectedContact}`);

                    if (!response.ok) {
                        throw new Error('No contacts found!');
                    }

                    const data = await response.json();
                    console.log("API Response:", data);

                    populateMessages (data);
                } catch (error) {
                    console.error('Error:', error.message);
                }
            }

            function populateContacts (data) {
                const contactList = document.getElementById("contactList");
                const messagesSection = document.getElementById("messages-section");

                contactList.innerHTML = ''; 
                messagesSection.innerHTML = '';

                data.contacts.forEach(contact => createContactElement(contact.username));
            }

            function populateMessages (data) {
                const messagesSection = document.getElementById("messages-section");

                messagesSection.innerHTML = '';

                data.messages.forEach(message => {
                    const sender = message.sentBy;
                    const msg = message.messageText;
                    const time = message.sentAt;
                    addMessageToInterface(sender, msg, time);
                });

                messagesSection.scrollTop = messagesSection.scrollHeight;
            }            


            function createContactElement(contactName) {
                console.log("Adding contact:", contactName);
                const contactList = document.getElementById("contactList");

                const imagePath = "/image/account_image.jpg";

                const button = document.createElement("button");
                button.classList.add("list-group-item", "list-group-item-action");
                button.innerHTML = `
                    <div class="d-flex align-items-center">
                        <img src="${imagePath}" alt="${contactName}" class="rounded-circle me-2" width="40" height="40">
                        ${contactName}
                    </div>
                `;
                button.addEventListener("click", function () {
                    selectContact(button, contactName);
                    fetchMessages(loggedInUser, contactName);
                });
                contactList.appendChild(button);
            }


            function selectContact(element, contactName) {
                selectedContact = contactName;
                document.querySelectorAll(".list-group-item").forEach(item => item.classList.remove("active"));
                element.classList.add("active");

                const messagesSection = document.getElementById("messages-section");
                messagesSection.innerHTML = "";

                fetchMessages (loggedInUser, selectedContact);
            }


            function addMessageToInterface(sender, message, time) {
                const messagesSection = document.getElementById("messages-section");

                const messageElement = document.createElement("div");
                const type = sender === loggedInUser ? "sent" : "received";
                messageElement.classList.add("message", type);

            messageElement.innerHTML = `
                <strong>${sender}:</strong> ${message}
                <div class="message-time text-muted">
                    ${new Date().toLocaleTimeString()}
                </div>
            `;

                messagesSection.appendChild(messageElement);

                messagesSection.scrollTop = messagesSection.scrollHeight;
            }



            document.getElementById("send-button").addEventListener("click", sendMessage);

            
            async function sendMessage() {
                const message = document.getElementById("message-input").value.trim();
                
                if (!selectedContact) {
                    alert("Please select a contact first.");
                    return;
                }

                if (!message) {
                    alert("Please enter a message.");
                    return;
                }

                try {
                    console.log("Sending message:", { selectedContact, message });
                    await connection.invoke("SendMessage", loggedInUser, selectedContact, message);
                    
                    document.getElementById("message-input").value = "";

                    addMessageToInterface(loggedInUser, message, Date.now());

                    contactMessages[selectedContact] = contactMessages[selectedContact] || [];
                    contactMessages[selectedContact].push({ sender: "You", message });

                } catch (err) {
                    console.error("Error sending message:", err);
                    alert("There was an error sending your message.");
                }
            }


            connection.on("ReceiveMessage", (sender, receiver, message) => {
                console.log("Received message:", { sender, receiver, message });
                if (selectedContact) {addMessageToInterface(sender, message, Date.now());}

                contactMessages[receiver] = contactMessages[receiver] || [];
                contactMessages[receiver].push({ sender, message });
            });




            document.getElementById("searchbar").addEventListener("input", searchContacts);
            function searchContacts(event) {
                const searchQuery = event.target.value.toLowerCase();
                
                const contactItems = document.querySelectorAll(".list-group-item");

                contactItems.forEach(item => {
                    const contactName = item.querySelector('div').textContent.toLowerCase().trim();
                    
                    if (contactName.includes(searchQuery)) {
                        item.style.display = "block";
                    } else {
                        item.style.display = "none";
                    }
                });
            }

            try {
                await connection.start();
                console.log("Connected to SignalR server.");
                await connection.invoke("ConnectToGroup", loggedInUser);
            } catch (err) {
                console.error("Failed to start SignalR connection:", err);
                alert("Failed to connect to the chat server.");
                return;
            }
        });
    </script>
</body>
</html>
